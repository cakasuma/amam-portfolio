# Copy to .env.local for local development. Every value below is optional
# locally — the app degrades rather than failing when one is absent.
#
# In production these are set in the Vercel dashboard, never in the repository.
# Never prefix a secret with NEXT_PUBLIC_ — that publishes it to the browser.

# --- Site -------------------------------------------------------------------
# Base URL for canonical and Open Graph links.
# Missing: falls back to the production domain.
NEXT_PUBLIC_SITE_URL=https://mustofaamami.dev

# --- Contact form (Resend) --------------------------------------------------
# API key from https://resend.com/api-keys
# Missing: submissions are logged to the server console instead of emailed.
# REQUIRED IN PRODUCTION — without it the form silently drops every message.
RESEND_API_KEY=re_your_api_key_here

# Recipient. Missing: falls back to the owner's address.
CONTACT_EMAIL=amammustofa@gmail.com

# Sender. Missing: falls back to Resend's onboarding sender.
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# --- Analytics --------------------------------------------------------------
# Google Analytics 4 measurement ID.
# Missing: the GA script is not injected. Vercel Analytics is unaffected.
NEXT_PUBLIC_GA_ID=
